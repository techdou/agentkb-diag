# ─────────────────────────────────────────────────────────────
# AgentKB-Diag Frontend 环境变量模板
# ─────────────────────────────────────────────────────────────
# 使用方法：
#   1. 复制本文件为 .env 或 .env.local：  cp .env.example .env
#   2. 在 .env 中填入你自己的真实值
#   3. .env / .env.local **不会**被提交到 Git（参见 .gitignore）
# ─────────────────────────────────────────────────────────────

# 后端 API 地址
# 本地开发：http://localhost:8000
# 生产部署：替换为你的后端域名
VITE_API_BASE_URL=http://localhost:8000

# 应用标题（可选）
VITE_APP_TITLE=AgentKB-Diag
