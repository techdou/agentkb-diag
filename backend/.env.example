# ─────────────────────────────────────────────────────────────
# AgentKB-Diag Backend 环境变量模板
# ─────────────────────────────────────────────────────────────
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 在 .env 中填入你自己的真实值
#   3. .env 文件**不会**被提交到 Git（参见 .gitignore）
# ─────────────────────────────────────────────────────────────

# ---- LLM 配置（必填）----
# 支持 openai / ollama / deepseek / qwen
LLM_PROVIDER=openai

# 你的 LLM API 密钥（绝不能上传到 GitHub）
# 获取方式：https://platform.openai.com/api-keys
LLM_API_KEY=sk-your-api-key-here

# 模型名称
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ---- Agent 流水线 ----
AGENT_DEFAULT_MODE=rule        # rule / llm
AGENT_MAX_RETRIES=3
AGENT_RETRY_DELAY_SECONDS=1.0

# ---- 路径（相对项目根）----
WORKSPACE_DIR=workspace
DATA_RAW_DIR=data/raw
WIKI_DIR=workspace/wiki
INDEX_DIR=workspace/index
ROUNDS_DIR=workspace/rounds
LOG_FILE=workspace/wiki/log.md

# ---- Semantic Scholar API（可选，用于数据采集）----
# 申请：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
